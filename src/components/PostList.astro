---
import FormattedDate from "./FormattedDate.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <FormattedDate date={post.data.pubDate} />
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-list li + li {
    border-top: 1px solid var(--border);
  }

  .post-list a {
    display: block;
    padding: 1.6rem 0;
    color: inherit;
    text-decoration: none;
  }

  .post-list :global(time) {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-list h3 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
    transition: color 0.2s ease;
  }

  .post-list p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .post-list a:hover h3,
  .post-list a:focus-visible h3 {
    color: var(--accent-strong);
  }
</style>
