---
const today = new Date();
---

<footer>
  <span>&copy; {today.getFullYear()} Uros Milojkovic</span>
</footer>
<style>
  footer {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    width: min(100% - 2rem, 1080px);
    margin: 0 auto;
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    footer {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
