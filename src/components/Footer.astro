---
import { SOCIAL_LINKS } from "../consts";

const today = new Date();
---

<footer>
  <span>&copy; {today.getFullYear()} Uros Milojkovic</span>
  <nav aria-label="Social links">
    {
      SOCIAL_LINKS.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))
    }
  </nav>
</footer>
<style>
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100% - 2rem, 1080px);
    margin: 0 auto;
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  a {
    position: relative;
    color: var(--muted);
    font-weight: 700;
    text-decoration: none;
  }

  a + a::before {
    position: absolute;
    top: 50%;
    left: -0.7rem;
    width: 1px;
    height: 0.85rem;
    background: var(--border-strong);
    content: "";
    transform: translateY(-50%);
  }

  a:hover,
  a:focus-visible {
    color: var(--accent-strong);
  }

  @media (max-width: 640px) {
    footer {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
